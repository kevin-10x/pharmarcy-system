# Pooled connection string (Vercel Postgres / Neon: POSTGRES_PRISMA_URL)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# Direct connection string (POSTGRES_URL_NON_POOLING)
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"
# Staff login
ADMIN_PASSWORD="change-me"
# Long random string, e.g. `openssl rand -hex 32`
AUTH_SECRET="change-me-too"
NEXT_PUBLIC_CURRENCY="USD"
NEXT_PUBLIC_PHARMACY_NAME="Greenleaf Pharmacy"
